{
  "name": "codex-trace-reader",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:portfolio": "vite --config vite.portfolio.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "build:portfolio": "npm run typecheck && vite build --config vite.portfolio.config.ts",
    "start": "electron-vite preview",
    "test": "node -e \"require('node:fs').rmSync('out/tests', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test \"out/tests/tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.4.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
